<Window x:Class="RevitCleanupManager.UI.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revit Cleanup Manager" Height="760" Width="1080"
        WindowStartupLocation="CenterScreen"
        Background="#1E1F22">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#2B2D30"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#3DDC97"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E8E8E8"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="#A0A0A0"/>

        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#10221A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButton" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#3A3D41"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="RowBackground" Value="#2B2D30"/>
            <Setter Property="AlternatingRowBackground" Value="#313337"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="RowHeight" Value="28"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#3A3D41"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: title + scan / native purge controls -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Vertical" Grid.Column="0">
                <TextBlock Text="Revit Cleanup Manager" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock x:Name="StatusText" Text="Click Scan Model to analyze the active document."
                           FontSize="12" Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                <Button x:Name="RunNativePurgeButton" Content="Run Native Purge Dialog" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0" Click="RunNativePurgeButton_Click"
                        ToolTip="Opens Revit's built-in Purge Unused dialog for full coverage (materials, line patterns, system families, etc.)"/>
                <Button x:Name="ScanButton" Content="Scan Model" Style="{StaticResource PrimaryButton}" Click="ScanButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Health summary strip -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="HealthScoreText" Text="--" FontSize="34" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    <StackPanel Margin="8,0,24,0" VerticalAlignment="Center">
                        <TextBlock Text="Model Health" FontSize="11" Foreground="{StaticResource SubTextBrush}"/>
                        <TextBlock x:Name="HealthGradeText" Text="Grade --" FontSize="13" Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                </StackPanel>
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" MaxHeight="70">
                    <ItemsControl x:Name="HealthNotesList" Foreground="{StaticResource SubTextBrush}" FontSize="12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Tabbed category grids -->
        <TabControl x:Name="CategoryTabs" Grid.Row="2" Background="Transparent" BorderThickness="0">
            <!-- Tabs are added dynamically in code-behind, one per CleanupCategory,
                 each containing a shared DataGrid template (see BuildTab in .xaml.cs) -->
        </TabControl>

        <!-- Footer: per-tab bulk actions -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectionSummaryText" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="{StaticResource SubTextBrush}" Text=""/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="SelectAllButton" Content="Select All (this tab)" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0" Click="SelectAllButton_Click"/>
                <Button x:Name="SelectNoneButton" Content="Select None (this tab)" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0" Click="SelectNoneButton_Click"/>
                <Button x:Name="CleanSelectedButton" Content="Clean Selected (all tabs)" Style="{StaticResource PrimaryButton}"
                        Click="CleanSelectedButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
