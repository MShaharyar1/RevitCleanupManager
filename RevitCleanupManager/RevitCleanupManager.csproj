<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MULTI-VERSION BUILD
    ====================
    Build for a specific Revit year by passing /p:RevitVersion=2024|2025|2026
    e.g.  dotnet build -c "Release 2025" -p:RevitVersion=2025
    Or just switch the Solution Configuration dropdown in Visual Studio
    (Debug 2024 / Debug 2025 / Debug 2026 ...) - it sets RevitVersion for you
    via the Configuration name parsing below.

    Revit 2024 and earlier -> .NET Framework 4.8
    Revit 2025 and later   -> .NET 8 (Windows)
  -->

  <PropertyGroup>
    <!-- Derive RevitVersion from the active Configuration name if not passed explicitly -->
    <RevitVersion Condition="'$(RevitVersion)'==''">2025</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('2024'))">2024</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('2025'))">2025</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('2026'))">2026</RevitVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RevitVersion)'=='2024'">
    <TargetFramework>net48</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RevitVersion)'=='2025' or '$(RevitVersion)'=='2026'">
    <TargetFramework>net8.0-windows</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RevitCleanupManager</RootNamespace>
    <AssemblyName>RevitCleanupManager.$(RevitVersion)</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Configurations>Debug 2024;Debug 2025;Debug 2026;Release 2024;Release 2025;Release 2026</Configurations>
  </PropertyGroup>

  <!-- Revit API - version-pinned NuGet packages (metadata-only, do not ship with your add-in) -->
  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="RevitCleanupManager.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    Post-build: copy the manifest + dll straight into the local Revit Addins folder
    for the matching year so F5 debugging with Revit as the start program "just works".
    Edit RevitStartAction below (Debug > RevitCleanupManager Properties) to launch Revit.exe.
  -->
  <Target Name="CopyToAddinsFolder" AfterTargets="Build">
    <ItemGroup>
      <AddinFiles Include="$(OutDir)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(AddinFiles)"
          DestinationFolder="$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)\RevitCleanupManager\%(RecursiveDir)"
          SkipUnchangedFiles="true"
          ContinueOnError="true" />
    <Copy SourceFiles="RevitCleanupManager.addin"
          DestinationFiles="$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)\RevitCleanupManager.addin"
          SkipUnchangedFiles="true"
          ContinueOnError="true" />
  </Target>

</Project>
